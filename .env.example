# Copy to .env and configure. Never commit .env.

# ==========================================
# 1. NOTIFICATIONS (Discord or Telegram)
# ==========================================
# Preferred: Discord Webhook (Instant setup: channel settings -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=

# Optional: Discord Bot (if sending via a registered Discord Bot Application)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Optional: Telegram Bot (@BotFather -> /newbot -> token, then run `python3 cli.py chatid`)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Active service: 'discord', 'telegram', or 'both' (auto-detected if blank)
NOTIFIER=discord

# ==========================================
# 2. TRACKS & REGIONAL FILTERS
# ==========================================
# Comma-separated roles to watch: pm, swe (default: pm,swe)
TRACKS=pm,swe

# Comma-separated regions to watch: us, ca, uk, apac, remote (default: all of them)
REGIONS=us,ca,uk,apac,remote

# ==========================================
# 3. SCHEDULE & DEBUG
# ==========================================
# Minutes between scans in `watch` mode
POLL_MINUTES=15

# Set to 1 to print alerts to terminal without sending to Discord/Telegram
DRY_RUN=0
